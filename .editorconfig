###############################################################################
# POSDeployTool - EditorConfig
###############################################################################

root = true

[*]
charset = utf-8-bom
end_of_line = crlf
insert_final_newline = true
trim_trailing_whitespace = true

[*.vb]
indent_style = space
indent_size = 4
tab_width = 4

[*.{vbproj,sln,config,resx,settings,json,xml}]
indent_style = space
indent_size = 2

[*.{cmd,bat,ps1}]
end_of_line = crlf
indent_style = space
indent_size = 4

[*.md]
charset = utf-8
end_of_line = lf
trim_trailing_whitespace = false
